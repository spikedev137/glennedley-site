---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts, years, postsForYear } from '../../data/posts';
import { factors } from '../../data/factors';
import { postsForFactor } from '../../data/posts';

const latest = posts.slice(0, 12);

import NewsletterSignup from '../../components/NewsletterSignup.astro';
---
<BaseLayout title="MondayMotivator Newsletter | Glenn Edley" description="A thought to start your week. Get MondayMotivator by Glenn Edley and explore past newsletters." showNewsletter={false}>
<main class="newsletter-page"><section class="newsletter-intro"><p class="eyebrow">MondayMotivator · Since 2004</p><h1>The MondayMotivator newsletter</h1><p class="lead">A fresh thought, practical idea or useful nudge to help you think differently and get your week moving.</p><p>I write about life, mindset, business and the things I’m learning along the way. Get a thought to start your week, delivered to your inbox every Monday.</p><NewsletterSignup id="newsletter-mondaymotivator" /><p class="signup-disclosure">One email a week, with the occasional extra when there’s something worth sharing. Unsubscribe at any time.</p><a href="#editions">Read past editions ↓</a></section><section class="newsletter-archive" id="editions"><h2>Past newsletters</h2><p>Explore the MondayMotivator archive, with weekly thoughts dating back to 2004.</p><h3>2026</h3>  <ol class="post-list">
    {latest.map((post) => (
      <li>
        <time datetime={post.date}>{new Date(`${post.date}T12:00:00`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
        <a href={`/mondaymotivator/${post.year}/${post.slug}/`}>{post.title}</a>
      </li>
    ))}
  </ol><h3>Browse by year</h3>  <div class="archive-years">
    {years.map((year) => <a href={`/mondaymotivator/${year}/`}>{year}<br /><small>{postsForYear(year).length}</small></a>)}
  </div></section><section class="newsletter-factors">  <h2>Browse by the Four Factors</h2>
  <p>These four ideas are the thread running through much of my writing. An edition can belong to more than one factor.</p>
  <div class="factor-grid">
    {factors.map((factor) => (
      <a class="factor-card" href={`/mondaymotivator/factor/${factor.slug}/`}>
        <strong>{factor.name}</strong>
        <span>{factor.short}</span>
        <small>{postsForFactor(factor.slug).length} related editions</small>
      </a>
    ))}
  </div>
  <p><a href="/four-factors/">Understand the Four Factors →</a></p>

</section></main></BaseLayout>
